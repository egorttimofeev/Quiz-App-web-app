# Telegram Bot Configuration
# Получите токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username

# Database Configuration  
DATABASE_URL=sqlite:///quiz_app.db

# Application Configuration
APP_HOST=localhost
APP_PORT=8000
APP_URL=http://localhost:8000

# Security
SECRET_KEY=your_secret_key_here_change_this_in_production

# Telegram Stars Payment
STARS_PROVIDER_TOKEN=your_provider_token_here
RETRY_COST_STARS=200

# Development Settings
DEBUG=true
ENVIRONMENT=development

# CORS Settings (разделенные запятыми)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://your-domain.com